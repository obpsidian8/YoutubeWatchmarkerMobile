{
    "background": {
    "service_worker": "background.js"
  },

   "action": {
      "default_icon": {
         "150": "content/icon.png"
      },
      "default_title": "YouTube Progress Saver",
      "default_popup": "content/popup.html"
   },
   "content_scripts": [ {
      "js": [ "content.js" ],
      "matches": [ "*://*.youtube.com/*", "*://m.youtube.com/*" ],
       "run_at": "document_idle"

   } ],
   "homepage_url": "https://github.com/obpsidian8/YoutubeWatchmarkerMobile",
   "icons": {
      "128": "content/icon.png"
   },
   "manifest_version": 3,
   "name": "YouTube Progress Saver",
   "description": "Save and view YouTube video progress across devices.",
   "permissions": ["storage", "tabs", "scripting"],
   "version": "1.76"
}

